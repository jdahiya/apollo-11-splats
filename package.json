{
  "name": "apollo-11-splats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gaussian splat model of the Apollo 11 landing site, Tranquility Base, trained from the mission's Hasselblad photographs. WebGL2 + WebAssembly.",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "serve": "node tools/serve.mjs dist 8080",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
